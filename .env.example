# Copy to .env.local — never commit real IDs
# Google Calendar Appointment Scheduler (BOOKING_SETUP.md)
VITE_BOOKING_URL=https://calendar.google.com/calendar/appointment/schedules/YOUR_ID
VITE_BOOKING_EMBED_URL=https://calendar.google.com/calendar/embed?src=YOUR_CALENDAR_ID&ctz=Asia/Kuala_Lumpur
# Formspree (https://formspree.io) — leave blank to fall back to mailto
VITE_FORMSPREE_ID=
