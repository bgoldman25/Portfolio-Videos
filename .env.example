# Copy to .env.local — never commit real IDs
# Cal.com event link — either "username/event-slug" or the full URL
# e.g. VITE_CALCOM_LINK=baltazargoldman/discovery
VITE_CALCOM_LINK=
# Resend (https://resend.com) — server-side only. NEVER prefix these with VITE_
# (that would ship the key to the browser). Used by api/contact.js.
# Local: put these in .env.local. Production: Vercel → Project Settings → Environment Variables.
RESEND_API_KEY=
# Sender — domain must be verified in Resend (Domains). Leave blank to use Resend's test sender (account owner only).
RESEND_FROM=
# Inbox that receives briefs (defaults to goldmanbaltazar@gmail.com)
CONTACT_TO_EMAIL=
